bool _IsFull(SeqQueue* Q) {
	return (Q->rear + 1) % MAXSIZE == Q->front;
}

bool _IsEmpty(SeqQueue* Q) {
	return Q->rear == Q->front;
}

int EnterQueue(SeqQueue* Q, QElemType x) {
	if (_IsFull(Q))
		return ERROR;
	Q->element[Q->rear] = x;
	Q->rear = (Q->rear + 1) % MAXSIZE;
	return OK;
}

int DeleteQueue(SeqQueue* Q, QElemType* x) {
	if (_IsEmpty(Q))
		return ERROR;
	*x = Q->element[Q->front];
	Q->front = (Q->front + 1) % MAXSIZE;
	return OK;
}

void YanghuiTriangle(int n) {//ѭ�����й���������ǵ�Ӧ��
	SeqQueue q;
	InitQueue(&q);
	EnterQueue(&q, 1);

	for (int row = 0; row < n; row++) {
		// ��ӡÿ��ǰ��Ŀո�
		for (int space = 0; space < n - row - 1; space++) {
			printf("   ");
		}

		int prev = 0;
		for (int col = 0; col <= row; col++) {
			int num;
			if (col == row) {
				num = 1;
			}
			else {
				DeleteQueue(&q, &num);
			}
			int next_num = prev + num;
			EnterQueue(&q, next_num);
			printf("%6d", num);
			prev = num;
		}
		printf("\n");
	}

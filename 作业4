void Transformation(int n, int base) {//˳��ջ���ڽ���ת����Ӧ��
	SeqStack S;
	SElemType x;
	InitStack(&S);
	while (n) {
		x = n % base;
		Push(&S, x);
		n /= base;
	}
	while (!IsEmpty(&S)) {
		Pop(&S, &x);
		if (x < 10)
			printf("%d", x);
		else
			printf("%c", x - 10 + 'A');
	}

bool IsFull(SeqStack* S) {
	return S->top == Stack_Size - 1;
}

bool IsEmpty(SeqStack* S) {
	return S->top == -1;
}

int Push(SeqStack* S, SElemType x) {
	if (S->top == Stack_Size - 1)
		return ERROR;
	S->top++;
	S->elem[S->top] = x;
	return OK;
}

int Pop(SeqStack* S, SElemType* x) {
	if (S->top == -1)
		return ERROR;
	else {
		*x = S->elem[S->top];
		S->top--;
		return OK;
	}
}
int GetTop(SeqStack* S, SElemType* x) {
	if (S->top == -1)
		return ERROR;
	else {
		*x = S->elem[S->top];
		return OK;
	}
}
